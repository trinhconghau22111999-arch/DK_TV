<resources>
    <!-- Nền icon app: xanh dương đậm - gợi liên tưởng "công nghệ/tin cậy", phù hợp cho app
         an ninh/giám sát gia đình. -->
    <color name="ic_launcher_background">#0B0B0D</color>
    <!-- Vòng kính ống kính camera - xanh dương sáng hơn để tạo chiều sâu, nổi bật trên nền -->
