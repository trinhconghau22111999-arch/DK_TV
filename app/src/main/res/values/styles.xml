<resources>
    <style name="GalleryColumnHeader">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Nút Sony: chính (nền cam, chữ đen) -->
    <style name="Widget.Sony.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/sony_btn_bg</item>
        <item name="android:textColor">@color/sony_btn_text</item>
        <item name="cornerRadius">6dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">44dp</item>
    </style>
    <!-- Nút Sony: viền cam, nền trong -->
    <style name="Widget.Sony.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/sony_btn_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/sony_btn_outline_text</item>
        <item name="rippleColor">@color/sony_orange_dim</item>
        <item name="cornerRadius">6dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">44dp</item>
    </style>
</resources>
