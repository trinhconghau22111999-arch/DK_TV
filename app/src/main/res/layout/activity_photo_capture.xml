<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/root_photo_capture"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="false">

    <!-- Hang tren: trang thai ket noi (trai) + ma ghep noi + Gui tep (phai).
         Khung chup nam SAT ngay duoi hang nay. -->
    <LinearLayout
        android:id="@+id/layout_connection_status"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pill_button"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/dot_connection_status"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_status_dot" />

        <TextView
            android:id="@+id/text_connection_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            tools:text="Chưa kết nối" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_top_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/text_pairing_code_chip"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_pill_button"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:letterSpacing="0.14"
            tools:text="Mã: 320100" />

        <Button
            android:id="@+id/btn_send_file"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_pill_accent"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0.06"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/btn_send_file"
            android:textAllCaps="true"
            android:textColor="#FF6B00"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Khung chup: dat SAT duoi 3 nut o hang tren, va tren khung nhap chu.
         scaleType=fitCenter de hien dung nguyen khung hinh (khong zoom/crop). -->
    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:scaleType="fitCenter"
        app:layout_constraintTop_toBottomOf="@id/layout_top_controls"
        app:layout_constraintBottom_toTopOf="@id/panel_text_input"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Lop phu toi dan o day khung chup de cac nut vuong luon ro tren moi nen -->
    <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@drawable/bg_scrim_bottom"
        app:layout_constraintBottom_toBottomOf="@id/camera_preview"
        app:layout_constraintStart_toStartOf="@id/camera_preview"
        app:layout_constraintEnd_toEndOf="@id/camera_preview" />

    <!-- Hang nut NAM TRONG khung chup: flash (trai) - chup (giua) - doi camera (phai).
         Tat ca la nut VUONG. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="@id/camera_preview"
        app:layout_constraintEnd_toEndOf="@id/camera_preview"
        app:layout_constraintStart_toStartOf="@id/camera_preview">

        <View
            android:id="@+id/btn_capture"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/bg_capture_square"
            android:clickable="true"
            android:contentDescription="Chụp ảnh"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:id="@+id/btn_toggle_flash"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_square_button"
            android:clickable="true"
            android:contentDescription="Bật/tắt đèn flash"
            android:focusable="true"
            android:padding="11dp"
            android:src="@drawable/ic_flash_off"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/btn_capture"
            app:layout_constraintBottom_toBottomOf="@id/btn_capture" />

        <!-- CHI hien sau khi da chup it nhat 1 tam trong phien nay - nam canh nut flash -->
        <ImageView
            android:id="@+id/btn_view_last_photo"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="70dp"
            android:background="@drawable/bg_square_button"
            android:clickable="true"
            android:contentDescription="Xem ảnh vừa chụp"
            android:focusable="true"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/btn_capture"
            app:layout_constraintBottom_toBottomOf="@id/btn_capture" />

        <ImageView
            android:id="@+id/btn_switch_camera"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_square_button"
            android:clickable="true"
            android:contentDescription="Đổi camera trước/sau"
            android:focusable="true"
            android:padding="11dp"
            android:src="@drawable/ic_camera_switch"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btn_capture"
            app:layout_constraintBottom_toBottomOf="@id/btn_capture" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Man hinh xem lai anh vua chup: phu dung len khung chup -->
    <FrameLayout
        android:id="@+id/layout_photo_review"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#000000"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/camera_preview"
        app:layout_constraintBottom_toBottomOf="@id/camera_preview"
        app:layout_constraintStart_toStartOf="@id/camera_preview"
        app:layout_constraintEnd_toEndOf="@id/camera_preview">

        <ImageView
            android:id="@+id/image_review_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Ảnh vừa chụp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/text_review_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="40dp"
            android:background="@drawable/bg_pill_button"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/hint_swipe_up_to_send"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

    </FrameLayout>

    <!-- NHAP CHU sang may tinh - nam DUOI khung chup (truoc la man hinh rieng) -->
    <LinearLayout
        android:id="@+id/panel_text_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sony_surface"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/text_input_title"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/text_input_hint_top"
            android:textColor="#B0B0B0"
            android:textSize="12sp" />

        <!-- CHI hien 1 dong (tu cuon theo con tro); van ban that van duoc giu day du va gui nguyen ven -->
        <EditText
            android:id="@+id/edit_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input_field"
            android:gravity="top|start"
            android:hint="Gõ ở đây…"
            android:inputType="textMultiLine|textNoSuggestions"
            android:maxLines="1"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#707070"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_paste"
                style="@style/Widget.Sony.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Dán" />

            <Button
                android:id="@+id/btn_clear_box"
                style="@style/Widget.Sony.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Xoá ô" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_input_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#9E9E9E"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="“Xoá ô” chỉ làm trống ô nhập trên điện thoại (không xoá chữ đã nhập trên web) - dùng khi bạn đổi sang ô khác trên máy tính."
            android:textColor="#707070"
            android:textSize="11sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
