<?xml version="1.0" encoding="utf-8"?>
<!--
    Icon phong cach SONY Alpha: nen den, than may den xam vien trang manh, ong kinh lon nhieu
    vong (vong trang + vong cam), diem nhan cam o goc tren-phai. Cac hinh chinh nam trong vung
    an toan 66dp cua Adaptive Icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- O ngam phia tren -->
    <path
        android:fillColor="#1E1E22"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:pathData="M44,37 L64,37 A2,2 0 0,1 66,39 L66,44 L42,44 L42,39 A2,2 0 0,1 44,37 Z" />

    <!-- Than may -->
    <path
        android:fillColor="#1E1E22"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:pathData="M36,44 L78,44 A4,4 0 0,1 82,48 L82,72 A4,4 0 0,1 78,76 L36,76 A4,4 0 0,1 32,72 L32,48 A4,4 0 0,1 36,44 Z" />

    <!-- Diem nhan cam goc tren-phai (kieu nut Sony) -->
    <path
        android:fillColor="#FF6B00"
        android:pathData="M70,48 L77,48 L77,52 L70,52 Z" />

    <!-- Ong kinh: vong trang ngoai -->
    <path
        android:fillColor="#0B0B0D"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:pathData="M41,61 A13,13 0 1,0 67,61 A13,13 0 1,0 41,61 Z" />

    <!-- Vong cam ben trong -->
    <path
        android:fillColor="#17171A"
        android:strokeColor="#FF6B00"
        android:strokeWidth="1.5"
        android:pathData="M46,61 A8,8 0 1,0 62,61 A8,8 0 1,0 46,61 Z" />

    <!-- Diem sang tren kinh -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M50,57 A2,2 0 1,0 54,57 A2,2 0 1,0 50,57 Z" />
</vector>
